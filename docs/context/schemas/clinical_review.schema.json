{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanitas.local/schemas/clinical_review.schema.json",
  "title": "ClinicalReview",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "page_number",
        "quote"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  },
  "required": [
    "schema_version",
    "report_summary",
    "clinical_concerns",
    "missing_information",
    "potential_inconsistencies",
    "requires_review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "clinical_concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "title",
          "description",
          "importance",
          "related_entity_ids",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^concern-[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "related_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "field",
          "reason",
          "importance"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^missing-[0-9]+$"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          }
        }
      }
    },
    "potential_inconsistencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "description",
          "importance",
          "related_entity_ids",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^incon-[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "related_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "requires_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "title",
          "reason",
          "importance",
          "related_entity_ids",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^review-[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "related_entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    }
  }
}