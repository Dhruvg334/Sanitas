{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanitas.local/schemas/clinical_extraction.schema.json",
  "title": "ClinicalExtraction",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "page_number",
        "quote"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "supportedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "support_status",
        "certainty",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "support_status": {
          "enum": [
            "supported",
            "uncertain",
            "conflicting"
          ]
        },
        "certainty": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "patient_information",
    "symptoms",
    "diagnoses",
    "medications",
    "vitals",
    "allergies",
    "clinical_observations",
    "uncertain_items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "patient_information": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "date_of_birth",
        "age",
        "sex",
        "medical_record_number"
      ],
      "properties": {
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/supportedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "date_of_birth": {
          "anyOf": [
            {
              "$ref": "#/$defs/supportedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "age": {
          "anyOf": [
            {
              "$ref": "#/$defs/supportedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "anyOf": [
            {
              "$ref": "#/$defs/supportedValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "medical_record_number": {
          "anyOf": [
            {
              "$ref": "#/$defs/supportedValue"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "name",
          "description",
          "onset",
          "duration",
          "severity",
          "support_status",
          "certainty",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^sym-[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "onset": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ]
          },
          "support_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting"
            ]
          },
          "certainty": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "name",
          "code",
          "diagnosis_status",
          "support_status",
          "certainty",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^dx-[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "diagnosis_status": {
            "enum": [
              "documented",
              "suspected",
              "historical",
              "ruled_out",
              "unknown"
            ]
          },
          "support_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting"
            ]
          },
          "certainty": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "medications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "name",
          "dose_value",
          "dose_unit",
          "route",
          "frequency",
          "medication_status",
          "support_status",
          "certainty",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^med-[0-9]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dose_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "dose_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "frequency": {
            "type": [
              "string",
              "null"
            ]
          },
          "medication_status": {
            "enum": [
              "active",
              "discontinued",
              "historical",
              "planned",
              "unknown"
            ]
          },
          "support_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting"
            ]
          },
          "certainty": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "vitals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "vital_type",
          "value",
          "unit",
          "qualifier",
          "observed_at",
          "support_status",
          "certainty",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^vital-[0-9]+$"
          },
          "vital_type": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "qualifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "support_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting"
            ]
          },
          "certainty": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "substance",
          "reaction",
          "allergy_status",
          "support_status",
          "certainty",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^alg-[0-9]+$"
          },
          "substance": {
            "type": "string",
            "minLength": 1
          },
          "reaction": {
            "type": [
              "string",
              "null"
            ]
          },
          "allergy_status": {
            "enum": [
              "present",
              "no_known_allergies",
              "uncertain"
            ]
          },
          "support_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting"
            ]
          },
          "certainty": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "clinical_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "category",
          "observation",
          "support_status",
          "certainty",
          "evidence"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^obs-[0-9]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "support_status": {
            "enum": [
              "supported",
              "uncertain",
              "conflicting"
            ]
          },
          "certainty": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    },
    "uncertain_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "field",
          "candidate_values",
          "reason",
          "evidence"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^unc-[0-9]+$"
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "candidate_values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    }
  }
}