{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanitas.local/schemas/canonical_document.schema.json",
  "title": "CanonicalDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_type",
    "document_quality",
    "quality_issues",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_type": {
      "enum": [
        "plain_text",
        "digital_pdf",
        "scanned_or_visual_pdf",
        "image"
      ]
    },
    "document_quality": {
      "enum": [
        "good",
        "degraded",
        "poor"
      ]
    },
    "quality_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_number",
          "segments",
          "unreadable_regions"
        ],
        "properties": {
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segment_id",
                "text",
                "segment_type",
                "certainty"
              ],
              "properties": {
                "segment_id": {
                  "type": "string",
                  "pattern": "^p[1-9][0-9]*-s[1-9][0-9]*$"
                },
                "text": {
                  "type": "string"
                },
                "segment_type": {
                  "enum": [
                    "paragraph",
                    "heading",
                    "table_row",
                    "list_item",
                    "form_field",
                    "other"
                  ]
                },
                "certainty": {
                  "enum": [
                    "high",
                    "medium",
                    "low"
                  ]
                }
              }
            }
          },
          "unreadable_regions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}