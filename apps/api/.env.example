# Sanitas API Environment Configuration
# Copy this file to .env for local overrides. Never commit actual secrets.

# Database configuration (PostgreSQL / Neon connection string)
# Leave empty for stateless mode in local dev/demo without persistence.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/sanitas?sslmode=require

# Gemini API credentials (keep empty to run foundation/health checks without external calls)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://sanitas-peach.vercel.app

# Input text, file size, and execution bounds
MAX_FILE_BYTES=10485760
MAX_PDF_PAGES=15
MAX_TEXT_CHARS=50000
MODEL_TIMEOUT_SECONDS=90

# Application environment and logging
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
